# SilverOS kernel fragment, merged on top of x86_64_defconfig.
# Built in, except the drivers that need firmware from the disk (Wi-Fi chips, GPUs): those are
# modules, loaded by rc.boot once the disk is mounted. Every module must carry the signature of
# the key made for this one build (the private key is never shipped), so nothing else can load.

CONFIG_LOCALVERSION="-silver"
CONFIG_DEFAULT_HOSTNAME="silver"
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_MODULE_SIG=y
CONFIG_MODULE_SIG_FORCE=y
CONFIG_MODULE_SIG_ALL=y
CONFIG_MODULE_SIG_SHA512=y
CONFIG_MODULE_SIG_KEY="certs/signing_key.pem"
CONFIG_MODULE_COMPRESS_NONE=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_XZ=y
CONFIG_RD_GZIP=y

# ---- Boot on real PCs: BIOS + UEFI ----
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_EFI_PARTITION=y
CONFIG_SYSFB_SIMPLEFB=y

# ---- Graphics: /dev/fb0 for the Silver desktop ----
CONFIG_DRM=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_DRM_BOCHS=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FB=y
CONFIG_FB_EFI=y
CONFIG_FB_VESA=y
CONFIG_FRAMEBUFFER_CONSOLE=y
# a crisp, larger console font for the text shell
CONFIG_FONTS=y
CONFIG_FONT_TER16x32=y
CONFIG_FONT_8x16=y
# no penguin logo: the greeter owns the screen
CONFIG_LOGO=n

# ---- Input ----
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_MOUSEDEV=y
CONFIG_MOUSE_PS2=y
CONFIG_HID_GENERIC=y
CONFIG_USB_HID=y
CONFIG_HID_MULTITOUCH=y
CONFIG_MOUSE_PS2_SYNAPTICS=y
CONFIG_I2C_HID_ACPI=y

# ---- Storage / USB boot media ----
CONFIG_USB_SUPPORT=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_OHCI_HCD=y
CONFIG_USB_UHCI_HCD=y
CONFIG_USB_STORAGE=y
CONFIG_USB_UAS=y
CONFIG_SATA_AHCI=y
CONFIG_BLK_DEV_NVME=y
CONFIG_BLK_DEV_SD=y
CONFIG_ISO9660_FS=y
CONFIG_VFAT_FS=y
CONFIG_EXT4_FS=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XZ=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_OVERLAY_FS=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y

# ---- Networking ----
CONFIG_E1000=y
CONFIG_E1000E=y
CONFIG_IGB=y
CONFIG_R8169=y
CONFIG_VIRTIO_NET=y
CONFIG_NETFILTER=y
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NFT_CT=y
CONFIG_NF_CONNTRACK=y

# ---- Hardening ----
CONFIG_RANDOMIZE_BASE=y
CONFIG_RANDOMIZE_MEMORY=y
CONFIG_STACKPROTECTOR_STRONG=y
CONFIG_STRICT_KERNEL_RWX=y
CONFIG_HARDENED_USERCOPY=y
CONFIG_FORTIFY_SOURCE=y
CONFIG_INIT_ON_ALLOC_DEFAULT_ON=y
CONFIG_INIT_STACK_ALL_ZERO=y
CONFIG_SLAB_FREELIST_RANDOM=y
CONFIG_SLAB_FREELIST_HARDENED=y
CONFIG_SHUFFLE_PAGE_ALLOCATOR=y
CONFIG_SECURITY=y
CONFIG_SECURITYFS=y
CONFIG_SECURITY_LOCKDOWN_LSM=y
CONFIG_SECURITY_LOCKDOWN_LSM_EARLY=y
CONFIG_LOCK_DOWN_KERNEL_FORCE_INTEGRITY=y
CONFIG_SECURITY_YAMA=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_LSM="lockdown,yama"
CONFIG_DEVMEM=n
CONFIG_DEVPORT=n
CONFIG_PROC_KCORE=n
CONFIG_KEXEC=n
CONFIG_KEXEC_FILE=n
CONFIG_HIBERNATION=n
CONFIG_LEGACY_VSYSCALL_NONE=y
CONFIG_X86_IOPL_IOPERM=n
CONFIG_USERFAULTFD=n
CONFIG_SECURITY_DMESG_RESTRICT=y
CONFIG_PANIC_ON_OOPS=y
CONFIG_PANIC_TIMEOUT=-1
CONFIG_BUG_ON_DATA_CORRUPTION=y
CONFIG_DEBUG_LIST=y
CONFIG_SCHED_STACK_END_CHECK=y
# 32-bit programs: Steam's client (and many games) are 32-bit. (x32 stays off.)
CONFIG_IA32_EMULATION=y
CONFIG_IA32_EMULATION_DEFAULT_DISABLED=n
CONFIG_X86_X32_ABI=n

# ---- Sound: the boot intro plays its sound effects through ALSA ----
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_PCM=y
CONFIG_SND_HDA_INTEL=y
CONFIG_SND_HDA_GENERIC=y
CONFIG_SND_HDA_CODEC_REALTEK=y
CONFIG_SND_HDA_CODEC_CONEXANT=y
CONFIG_SND_HDA_CODEC_ANALOG=y
CONFIG_SND_HDA_CODEC_SIGMATEL=y
CONFIG_SND_HDA_CODEC_VIA=y
CONFIG_SND_HDA_CODEC_CIRRUS=y
CONFIG_SND_HDA_CODEC_HDMI=y
CONFIG_SND_USB=y
CONFIG_SND_USB_AUDIO=y

# ---- Wi-Fi: the common laptop/desktop chips (firmware: firmware/wifi.list) ----
CONFIG_CFG80211=y
CONFIG_MAC80211=y
CONFIG_RFKILL=y
CONFIG_IWLWIFI=m
CONFIG_IWLMVM=m
CONFIG_IWLMLD=m
CONFIG_RTW88=m
CONFIG_RTW88_8822CE=m
CONFIG_RTW88_8822BE=m
CONFIG_RTW88_8821CE=m
CONFIG_RTW88_8723DE=m
CONFIG_RTW88_8822CU=m
CONFIG_RTW88_8822BU=m
CONFIG_RTW88_8821CU=m
CONFIG_RTW89=m
CONFIG_RTW89_8852AE=m
CONFIG_RTW89_8852BE=m
CONFIG_RTW89_8852CE=m
CONFIG_RTW89_8851BE=m
CONFIG_RTW89_8922AE=m
CONFIG_MT7921E=m
CONFIG_MT7921U=m
CONFIG_MT7925E=m
CONFIG_MT7925U=m
CONFIG_ATH9K=m
CONFIG_ATH9K_PCI=m
CONFIG_ATH10K=m
CONFIG_ATH10K_PCI=m
CONFIG_ATH11K=m
CONFIG_ATH11K_PCI=m
CONFIG_ATH12K=m
# a pretend Wi-Fi radio for the automated test; it makes no radios unless asked
# (mac80211_hwsim.radios=2 on the kernel command line; build-kernel.sh sets the default to 0)
CONFIG_MAC80211_HWSIM=y

# ---- Graphics cards, for games (Mesa drives them; firmware: firmware/gpu.list) ----
CONFIG_DRM_AMDGPU=m
CONFIG_DRM_AMDGPU_SI=y
CONFIG_DRM_AMDGPU_CIK=y
CONFIG_DRM_AMD_DC=y
CONFIG_DRM_I915=m
CONFIG_DRM_XE=m
CONFIG_DRM_NOUVEAU=m
CONFIG_DRM_VIRTIO_GPU=y
CONFIG_VIRTIO_PCI=y
CONFIG_HSA_AMD=n
# Steam's game containers (pressure-vessel) need user namespaces
CONFIG_USER_NS=y
CONFIG_SYNC_FILE=y
CONFIG_UDMABUF=y
# Steam's controller support and Steam Input
CONFIG_INPUT_UINPUT=y
CONFIG_HID_STEAM=y
CONFIG_HID_SONY=y
CONFIG_HID_NINTENDO=y
CONFIG_HID_MICROSOFT=y
CONFIG_JOYSTICK_XPAD=y

# ---- Bluetooth: USB and laptop adapters (firmware: firmware/gpu.list's Bluetooth part) ----
CONFIG_BT=y
CONFIG_BT_BREDR=y
CONFIG_BT_LE=y
CONFIG_BT_RFCOMM=y
CONFIG_BT_HIDP=y
CONFIG_BT_BNEP=y
CONFIG_BT_HCIBTUSB=m
CONFIG_BT_HCIBTUSB_MTK=y
CONFIG_BT_HCIBTUSB_BCM=y
CONFIG_BT_HCIBTUSB_RTL=y
CONFIG_BT_HCIUART=m
CONFIG_BT_HCIUART_BCM=y
CONFIG_BT_HCIUART_QCA=y
CONFIG_BT_HCIUART_INTEL=y
CONFIG_BT_HCIUART_RTL=y
CONFIG_BT_MTKSDIO=m
CONFIG_UHID=y
CONFIG_NEW_LEDS=y
CONFIG_LEDS_CLASS=y
CONFIG_LEDS_CLASS_MULTICOLOR=y
CONFIG_POWER_SUPPLY=y
CONFIG_HID_PLAYSTATION=y
CONFIG_PLAYSTATION_FF=y

# ---- CPU speed and power: the drivers modern Intel and AMD chips need, and a sensible default ----
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y
CONFIG_CPU_FREQ_GOV_POWERSAVE=y
CONFIG_CPU_FREQ_GOV_CONSERVATIVE=y
CONFIG_X86_INTEL_PSTATE=y
CONFIG_X86_AMD_PSTATE=y
CONFIG_X86_ACPI_CPUFREQ=y
CONFIG_INTEL_IDLE=y
