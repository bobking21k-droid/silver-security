#!/bin/sh
# First boot: accounts are locked until the owner sets passwords here.
# Setup runs on whichever console the owner presses Enter at first.
tty=$1; shift
if grep -q '^silver:!' /etc/shadow; then
  clear; cat /etc/issue
  echo "  Press Enter to begin first boot setup."
  # wake up when Enter is pressed here, or when another console finished setup
  while grep -q '^silver:!' /etc/shadow && ! read -t 1 _; do :; done
  if grep -q '^silver:!' /etc/shadow && mkdir /run/firstboot 2>/dev/null; then
    clear; cat /etc/issue
    echo "  First boot setup -- choose passwords."
    echo; echo "  Password for your user 'silver':"; until passwd silver; do :; done
    echo; echo "  Password for 'root' (used with su):"; until passwd root; do :; done
  else
    echo "  First boot setup is running on another console..."
    while grep -q '^silver:!' /etc/shadow; do sleep 1; done
  fi
fi
# tty1 with a framebuffer: the graphical SilverOS login; everything else: text getty
if [ "$tty" = tty1 ] && [ -c /dev/fb0 ] && [ -x /sbin/silver-greeter ]; then
  exec /sbin/silver-greeter "$tty"
fi
exec /sbin/getty "$@" "$tty"
