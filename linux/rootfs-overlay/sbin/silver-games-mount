#!/bin/sh
# (The games layer sits on top, so its GNU tools win over BusyBox's under /usr/bin; /bin stays BusyBox.)
# Mount the games layer (games.sqfs: Mesa, Vulkan, Xorg, PulseAudio, the 32-bit libraries the
# Steam app needs) underneath /usr, read-only. Installed systems keep it in /boot; the live USB
# has it on the stick. Without it SilverOS works as before, and the Game Store says so.
img=/boot/games.sqfs
if [ ! -f "$img" ]; then
  mkdir -p /run/silver-gmedia
  for dev in /dev/sr* /dev/sd? /dev/nvme?n? /dev/vd? /dev/mmcblk?; do
    [ -b "$dev" ] || continue
    if mount -o ro -t iso9660 "$dev" /run/silver-gmedia 2>/dev/null; then
      [ -f /run/silver-gmedia/boot/silver/SILVEROS_MEDIA ] && [ -f /run/silver-gmedia/boot/games.sqfs ] && { img=/run/silver-gmedia/boot/games.sqfs; break; }
      umount /run/silver-gmedia
    fi
  done
fi
[ -f "$img" ] || exit 0
mkdir -p /run/games
mount -t squashfs -o ro,loop "$img" /run/games || exit 1
# keep SilverOS's own /usr reachable (the installer copies it, not the games layer on top of it)
mkdir -p /run/usr-base; mount --bind /usr /run/usr-base || { umount /run/games; exit 1; }
mount -t overlay overlay -o lowerdir=/run/games:/run/usr-base /usr || { umount /run/usr-base; umount /run/games; exit 1; }
echo "games layer: $img"
