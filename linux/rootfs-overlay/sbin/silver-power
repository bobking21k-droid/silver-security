#!/bin/sh
# Laptop power saving: on battery, ask the CPUs to save power; on mains, put the normal setting back.
# Does nothing on a computer without a battery. Started by rc.boot, runs quietly in the background.
ls /sys/class/power_supply/BAT* >/dev/null 2>&1 || exit 0
first=$(ls /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor 2>/dev/null) || exit 0
default=$(cat "$first" 2>/dev/null); [ -n "$default" ] || exit 0
state=""
while :; do
  ac=0
  for p in /sys/class/power_supply/*; do
    [ "$(cat "$p/type" 2>/dev/null)" = Mains ] && [ "$(cat "$p/online" 2>/dev/null)" = 1 ] && ac=1
  done
  now=battery; [ $ac = 1 ] && now=mains
  if [ "$now" != "$state" ]; then
    state=$now
    if [ $now = battery ]; then gov=powersave; else gov=$default; fi
    for g in /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do echo "$gov" > "$g" 2>/dev/null; done
  fi
  sleep 20
done
