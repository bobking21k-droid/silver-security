#!/bin/sh
# silver-install -- install SilverOS next to Windows (UEFI + GPT).
#
# What it does, in order (nothing is written before you confirm):
#   1. finds the internal disk that holds Windows' EFI System Partition (ESP)
#   2. picks the largest block of *unallocated* space (you make it by shrinking
#      Windows in Disk Management -- this tool never resizes or touches NTFS)
#   3. creates one ext4 partition there and copies the running system onto it
#   4. copies the boot chooser (silverboot) + GRUB to \EFI\SilverOS\ on the existing ESP
#      (Windows' own files in \EFI\Microsoft are left alone)
#   5. adds a firmware boot entry "SilverOS" and puts it first, so the chooser
#      is the first thing you see when the computer turns on
set -eu

LINUX_ROOT_TYPE=4F68BCE3-E8CD-4DB1-96E7-FBCAF984B709   # GPT: Linux root (x86-64)
ESP_TYPE=C12A7328-F81F-11D2-BA4B-00A0C93EC93B           # GPT: EFI System Partition
MIN_MB=4096
LOADER='\EFI\SilverOS\silverboot.efi'
MEDIA=/run/silver-media ESP=/run/silver-esp TARGET=/run/silver-target

b() { printf '\033[1;37m%s\033[0m\n' "$*"; }
warn() { printf '\033[1;33m  ! %s\033[0m\n' "$*"; }
die() { printf '\033[1;31msilver-install: %s\033[0m\n' "$*" >&2; cleanup; exit 1; }
cleanup() {
  for m in "$TARGET" "$ESP" "$MEDIA"; do umount "$m" 2>/dev/null || true; done
}
human() { awk -v s="$1" 'BEGIN{ b=s*512; split("B KB MB GB TB",u," "); i=1; while (b>=1024 && i<5){b/=1024;i++} printf "%.1f %s", b, u[i] }'; }
partdev() { case "$1" in *[0-9]) echo "${1}p$2" ;; *) echo "$1$2" ;; esac; }

[ "$(id -u)" = 0 ] || die "run this as root: su -c silver-install"
[ -d /sys/firmware/efi ] || die "this USB stick was started in legacy BIOS mode.
  Reboot, open your PC's boot menu and pick the entry that starts with 'UEFI:'."
mountpoint -q /sys/firmware/efi/efivars || mount -t efivarfs efivarfs /sys/firmware/efi/efivars
mkdir -p "$MEDIA" "$ESP" "$TARGET"
trap cleanup EXIT INT TERM

clear 2>/dev/null || true
b "  SilverOS installer -- dual boot with Windows"
echo

# ---- 1. find our boot media (to get the kernel + boot chooser, and to skip that disk)
MEDIADISK=
for dev in /dev/sr* /dev/sd? /dev/nvme?n? /dev/vd? /dev/mmcblk?; do
  [ -b "$dev" ] || continue
  if mount -o ro -t iso9660 "$dev" "$MEDIA" 2>/dev/null; then
    if [ -f "$MEDIA/boot/silver/SILVEROS_MEDIA" ]; then MEDIADISK=${dev#/dev/}; break; fi
    umount "$MEDIA"
  fi
done
[ -n "$MEDIADISK" ] || die "cannot find the SilverOS USB stick / disc"

# ---- 2. find the disk with Windows' ESP
CANDIDATES=
for sys in /sys/block/*; do
  d=${sys##*/}
  case "$d" in loop*|ram*|sr*|zram*|"$MEDIADISK") continue ;; esac
  sfdisk -d "/dev/$d" 2>/dev/null | grep -q '^label: gpt' || continue
  sfdisk -d "/dev/$d" | grep -qi "type=$ESP_TYPE" || continue
  CANDIDATES="$CANDIDATES $d"
done
set -- $CANDIDATES
[ $# -gt 0 ] || die "no GPT disk with an EFI System Partition found.
  SilverOS dual boot needs Windows installed in UEFI mode (normal for Windows 10/11)."
if [ $# -eq 1 ]; then DISK=$1
else
  echo "  Disks with an EFI System Partition:"
  i=1; for d in "$@"; do
    printf '   %d) /dev/%s  %s  %s\n' $i "$d" "$(human "$(cat /sys/block/$d/size)")" "$(cat /sys/block/$d/device/model 2>/dev/null)"
    i=$((i+1)); done
  printf '  Install to which disk? [1-%d] ' $#; read -r n
  eval "DISK=\${$n:-}"; [ -n "$DISK" ] || die "no disk chosen"
fi
DEV=/dev/$DISK
MODEL=$(cat /sys/block/$DISK/device/model 2>/dev/null | sed 's/ *$//')
DUMP=$(sfdisk -d "$DEV")

# ESP partition number
ESPLINE=$(echo "$DUMP" | grep -i "type=$ESP_TYPE" | head -1)
ESPDEV=${ESPLINE%% *}
ESPNUM=$(echo "$ESPDEV" | sed 's/.*[^0-9]\([0-9][0-9]*\)$/\1/')

mount -t vfat "$ESPDEV" "$ESP" || die "cannot mount the EFI System Partition $ESPDEV"
WINDOWS=no
[ -f "$ESP/EFI/Microsoft/Boot/bootmgfw.efi" ] && WINDOWS=yes
ESPFREE_KB=$(df -k "$ESP" | awk 'NR==2{print $4}')
umount "$ESP"
[ "$ESPFREE_KB" -ge 10240 ] || die "the EFI System Partition has only ${ESPFREE_KB} KB free; SilverOS needs 10 MB"

if echo "$DUMP" | grep -qi 'name="SilverOS"'; then
  die "$DEV already has a SilverOS partition. Remove it first (see README: Uninstall)."
fi

# ---- 3. largest unallocated region
FREE=$(sfdisk -F -q "$DEV" 2>/dev/null | awk 'NF>=3 && $1 ~ /^[0-9]+$/ {print $1, $3}' | sort -k2 -n | tail -1)
[ -n "$FREE" ] || FREE="0 0"
FSTART=${FREE% *}; FSECT=${FREE#* }
SSZ=$(cat /sys/block/$DISK/queue/logical_block_size)
FREE_MB=$((FSECT * SSZ / 1048576))
if [ "$FREE_MB" -lt "$MIN_MB" ]; then
  die "only ${FREE_MB} MB of unallocated space on $DEV; SilverOS needs at least ${MIN_MB} MB.
  In Windows: right-click Start > Disk Management > right-click C: > Shrink Volume.
  Leave the new space 'Unallocated' (do not format it), then run silver-install again."
fi

# ---- BitLocker check on every NTFS-looking partition
BITLOCKER=no
for p in $(echo "$DUMP" | awk -F' : ' '/^\/dev\//{print $1}'); do
  sig=$(dd if="$p" bs=1 skip=3 count=8 2>/dev/null || true)
  [ "$sig" = "-FVE-FS-" ] && BITLOCKER=yes
done

# ---- 4. the plan
echo
b "  Plan"
echo "   Disk:            $DEV ${MODEL:+($MODEL)}  $(human "$(cat /sys/block/$DISK/size)")"
echo "   Windows found:   $WINDOWS"
echo "   New partition:   SilverOS, ext4, $(human $((FSECT * SSZ / 512))) of unallocated space"
echo "   Boot chooser:    $LOADER on $ESPDEV (Windows files untouched)"
echo "   Firmware entry:  'SilverOS' first in boot order -> split screen: SilverOS | Windows"
echo "   Not touched:     Windows partitions, recovery partition, \\EFI\\Microsoft"
echo
[ "$WINDOWS" = yes ] || warn "No Windows Boot Manager found on $ESPDEV. The chooser will only offer SilverOS."
if [ "$BITLOCKER" = yes ]; then
  warn "BitLocker is on. Windows may ask for your recovery key after the boot order changes"
  warn "or after Secure Boot is turned off. Have it ready: https://aka.ms/myrecoverykey"
fi
warn "Turn off Windows Fast Startup (Control Panel > Power Options) before using both systems."
echo
printf '  Type  install  to continue, anything else to cancel: '
read -r answer
[ "$answer" = install ] || { echo "  Cancelled. Nothing was changed."; exit 0; }

# ---- 5. do it
echo; b "  [1/5] Creating the SilverOS partition"
echo "start=$FSTART, size=$FSECT, type=$LINUX_ROOT_TYPE, name=\"SilverOS\"" | \
  sfdisk --append --wipe-partitions always -q "$DEV" || die "partitioning failed (nothing else was changed)"
NUM=$(sfdisk -d "$DEV" | grep 'name="SilverOS"' | sed 's/^[^ ]*[^0-9]\([0-9][0-9]*\) :.*/\1/')
PART=$(partdev "$DEV" "$NUM")
i=0; while [ ! -b "$PART" ] && [ $i -lt 50 ]; do sleep 0.1; i=$((i+1)); done
[ -b "$PART" ] || die "kernel did not pick up the new partition $PART; reboot and retry"
PARTUUID=$(sfdisk --part-uuid "$DEV" "$NUM")

b "  [2/5] Formatting $PART (ext4)"
mke2fs -q -F -t ext4 -L SilverOS "$PART"
FSUUID=$(blkid "$PART" | sed -n 's/.* UUID="\([^"]*\)".*/\1/p')
[ -n "$FSUUID" ] || die "could not read filesystem UUID of $PART"

b "  [3/5] Copying SilverOS"
mount -t ext4 "$PART" "$TARGET"
( cd / && tar -cf - bin sbin usr etc root home var init ) | ( cd "$TARGET" && tar -xpf - )
mkdir -p "$TARGET/dev" "$TARGET/proc" "$TARGET/sys" "$TARGET/run" "$TARGET/tmp" "$TARGET/mnt" "$TARGET/boot"
chmod 1777 "$TARGET/tmp"
cp "$MEDIA/boot/vmlinuz" "$TARGET/boot/vmlinuz"
cat > "$TARGET/etc/silver-installed" <<EOF
disk=$DEV
root=PARTUUID=$PARTUUID
esp=$ESPDEV
installed=$(date -u +%Y-%m-%dT%H:%M:%SZ)
EOF
sync; umount "$TARGET"

b "  [4/5] Installing the boot chooser on $ESPDEV"
mount -t vfat "$ESPDEV" "$ESP"
mkdir -p "$ESP/EFI/SilverOS"
cp "$MEDIA/boot/silver/silverboot.efi" "$MEDIA/boot/silver/grubx64.efi" "$ESP/EFI/SilverOS/"
# GRUB runs after the chooser picked SilverOS: boot straight through.
# Hold Shift while it starts for a plain recovery menu.
{
  echo "# SilverOS kernel loader -- written by silver-install"
  echo "set timeout_style=hidden"
  echo "set timeout=0"
  echo "set default=silveros"
  echo "terminal_output console"
  echo "if keystatus --shift; then set timeout_style=menu; set timeout=-1; fi"
  echo
  echo "menuentry \"SilverOS\" --id silveros {"
  echo "    search --no-floppy --fs-uuid --set=root $FSUUID"
  echo "    linux /boot/vmlinuz root=PARTUUID=$PARTUUID rootfstype=ext4 rootwait rw quiet loglevel=3 vt.global_cursor_default=0 fbcon=font:TER16x32 console=tty1"
  echo "}"
  echo "menuentry \"SilverOS (verbose boot)\" {"
  echo "    search --no-floppy --fs-uuid --set=root $FSUUID"
  echo "    linux /boot/vmlinuz root=PARTUUID=$PARTUUID rootfstype=ext4 rootwait rw fbcon=font:TER16x32 console=tty1"
  echo "}"
  if [ "$WINDOWS" = yes ]; then
  echo "menuentry \"Windows\" {"
  echo "    search --no-floppy --file --set=root /EFI/Microsoft/Boot/bootmgfw.efi"
  echo "    chainloader /EFI/Microsoft/Boot/bootmgfw.efi"
  echo "}"
  fi
  echo "menuentry \"Firmware setup\" { fwsetup }"
} > "$ESP/EFI/SilverOS/grub.cfg"
sync; umount "$ESP"

b "  [5/5] Adding the firmware boot entry"
silver-efiboot create "$DEV" "$ESPNUM" "$LOADER" SilverOS

echo
b "  Done. Remove the USB stick and restart."
echo "  When the computer turns on you'll see the SilverOS chooser: SilverOS or Windows."
echo "  If your PC goes straight to Windows instead, see README: 'PC skips the chooser'."
