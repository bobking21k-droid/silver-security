# Graphics card firmware taken from the linux-firmware release tarball (FIRMWARE_TAG), for
# games: AMD (amdgpu, older radeon), Intel (i915, xe), Nvidia GeForce for nouveau
# (Maxwell to Blackwell; GSP firmware for RTX 20 and newer), and Bluetooth adapters at the
# end. Paths are shell globs.
# Each vendor's licence travels with it in /lib/firmware/LICENSES.
amdgpu/*
radeon/*
i915/*
xe/*
nvidia/gm2*
nvidia/gp10[0-8]
nvidia/gv100
nvidia/tu1*
nvidia/ga10[2-7]
nvidia/ad10*
nvidia/gb20*
LICENSES/LICENSE.amdgpu
LICENSES/LICENSE.radeon
LICENSES/LICENSE.i915
LICENSES/LICENSE.xe
LICENSES/LICENCE.nvidia
# Bluetooth adapters: Intel, Realtek, MediaTek, Qualcomm, Broadcom (the chips the Wi-Fi list covers)
intel/ibt-*
rtl_bt/*
mediatek/BT_RAM_CODE_MT79*
mediatek/mt7925/BT_RAM_CODE*
qca/rampatch_*
qca/nvm_*
qca/hpbtfw*
qca/hpnv*
brcm/BCM*.hcd
LICENSES/LICENCE.ibt_firmware
LICENSES/LICENCE.rtlwifi_firmware.txt
LICENSES/LICENCE.mediatek
LICENSES/LICENSE.QualcommAtheros_ath10k
LICENSES/LICENCE.broadcom_bcm43xx
